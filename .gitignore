.vscode/


# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env

node_modules/

config/dsh/sessions/

/logs/

/workspace/

/data/*
!/data/email-demo/
# GitTaskBench 资源包体积大（含 19 MB 仓库快照），只入库包内 README，
# 说明如何重建资源包；其余文件仍按上面的规则忽略。
!/data/gittaskbench/
/data/gittaskbench/*
!/data/gittaskbench/README.md
# 技能是生成器的产物（纯文本，几 KB），属于实验交付物，随仓库一起入库。
!/data/gittaskbench/skills/
# 镜像定义是资源包的一部分：缺了它容器模式无法重建，体积只有几 KB。
!/data/gittaskbench/environment/
